# ─────────────────────────────────────────────────────────────────────────────
# Guardado de inscripciones + comprobantes
#
# Sin estas variables, en desarrollo todo se guarda en .data/ (local).
# En producción (Vercel) son OBLIGATORIAS: ver docs/google-apps-script.gs
# ─────────────────────────────────────────────────────────────────────────────

# URL del Web App de Google Apps Script (termina en /exec)
GOOGLE_SCRIPT_URL=

# Clave compartida: tiene que ser igual a SECRET dentro del Apps Script.
# Habilita el guardado en Sheets/Drive y el envío de códigos con GmailApp.
GOOGLE_SCRIPT_SECRET=

# URL pública del sitio; en Vercel debe ser el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
